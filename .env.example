# =============================================================================
# Aplicação
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Segredo usado para assinar o cookie de sessão local (mín. 32 caracteres).
AUTH_SECRET=troque-este-segredo-em-producao-com-32-caracteres

# =============================================================================
# Supabase (opcional no modo demonstração)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
# Projetos novos: publishable key (pode ir para o navegador).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com o nome antigo (anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Projetos novos: secret key (SOMENTE no servidor).
# Necessária para auditoria e para ler os tokens do Drive de outro usuário
# (ex.: aluno assistindo a um vídeo da biblioteca do professor).
SUPABASE_SECRET_KEY=
# Compatibilidade com o nome antigo (service_role JWT).
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Resend (opcional — sem chave, e-mails vão para a caixa de saída local)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL="Jiu-Jitsu App <nao-responda@bjj.app>"

# =============================================================================
# Google OAuth via provider do Supabase Auth
# =============================================================================
# O login/cadastro/conexão Google usa o provider Google do Supabase Auth.
# Configure no painel do Supabase:
#   1. Authentication → Providers → Google: habilite e informe o Client ID/Secret.
#   2. Authentication → URL Configuration → Redirect URLs: adicione
#        https://SEU_DOMINIO/api/auth/google/callback
#        https://SEU_DOMINIO/api/google-drive/oauth/callback
# O modo "Conectar conta Google" usa o mesmo signInWithOAuth e valida que o
# e-mail Google é igual ao da conta logada (evita trocar de conta sem avisar).
# No Google Cloud Console, a Authorized redirect URI é a do Supabase:
#   https://<PROJECT_REF>.supabase.co/auth/v1/callback
# As credenciais abaixo também são usadas para renovar o access token do Drive
# diretamente na API do Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legado: usado apenas pelas rotas antigas de OAuth direto do Drive.
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Chave dedicada para AES-256-GCM (mín. 32 caracteres). Em produção, gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Nunca reutilize a mesma chave entre development e production.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_SALT=bjj-google-oauth-salt-v1
# Deixe vazio para usar openid email profile drive.file (recomendado).
GOOGLE_OAUTH_SCOPES=

# Rate limiting dos endpoints /api/auth/google/* por IP.
OAUTH_RATE_LIMIT_MAX=10
OAUTH_RATE_LIMIT_WINDOW_MS=60000
# Opcional: rate limit compartilhado entre instâncias serverless (Upstash Redis).
# Sem essas variáveis, o fallback é em memória por instância.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Google Drive — armazenamento de vídeos
# =============================================================================
# Reutiliza o OAuth Client ID/Secret acima. Adicione em "Authorized redirect URIs":
#   http://localhost:3000/api/google-drive/oauth/callback
#   https://SEU_DOMINIO/api/google-drive/oauth/callback
NEXT_PUBLIC_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive/oauth/callback
# Escopos mínimos: drive.file limita o acesso aos arquivos criados pela plataforma.
GOOGLE_DRIVE_SCOPES=openid email https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_FOLDER_ROOT=Plataforma de Treinamento
# Chave opcional para chamadas públicas (não é usada no fluxo OAuth do usuário).
GOOGLE_DRIVE_API_KEY=
# Limite de 5GB por arquivo.
GOOGLE_DRIVE_MAX_FILE_BYTES=5368709120
# Retry/backoff exponencial e circuit breaker.
GOOGLE_DRIVE_RETRY_BASE_MS=1000
GOOGLE_DRIVE_MAX_RETRIES=3
GOOGLE_DRIVE_CIRCUIT_BREAKER_MS=300000
# Segredo das URLs de reprodução assinadas (fallback: AUTH_SECRET).
PLAYBACK_TOKEN_SECRET=

# =============================================================================
# Armazenamento local do MVP
# =============================================================================
# "file" (padrão) persiste em .data/db.json; "memory" reinicia a cada processo.
BJJ_STORE=file
# BJJ_DB_FILE=C:\caminho\para\db.json
